Options -Indexes -MultiViews
DirectoryIndex index.php

RewriteEngine On
# No hidden files, even if accidentally included in a release.
RewriteRule (^|/)\. - [R=404,L]
RewriteRule ^index\.php$ - [L]
# Only the asset directory is served directly; all pages use the front controller.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^assets/ - [L]
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.[a-f0-9]{12}\.(css|woff2|webp|jpg|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/xml application/json image/svg+xml
</IfModule>
